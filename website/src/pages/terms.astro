---
import LegalLayout from '../layouts/LegalLayout.astro';
import { LEGAL_ROUTES, renderLegalHtml } from '../lib/legal';

const html = renderLegalHtml(LEGAL_ROUTES.terms.file);
---

<LegalLayout
  title={LEGAL_ROUTES.terms.title}
  description="Terms of Service for using Wubbler."
>
  <div class="prose" set:html={html} />
</LegalLayout>
