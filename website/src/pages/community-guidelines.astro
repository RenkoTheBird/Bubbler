---
import LegalLayout from '../layouts/LegalLayout.astro';
import { LEGAL_ROUTES, renderLegalHtml } from '../lib/legal';

const html = renderLegalHtml(LEGAL_ROUTES.guidelines.file);
---

<LegalLayout
  title={LEGAL_ROUTES.guidelines.title}
  description="Community Guidelines for Wubbler."
>
  <div class="prose" set:html={html} />
</LegalLayout>
