---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoreBadges from '../components/StoreBadges.astro';
---

<BaseLayout title="Wubbler">
  <div class="page">
    <SiteHeader />
    <main>
      <section class="hero" aria-label="Wubbler">
        <div class="hero-copy">
          <p class="brand-lockup">Wubbler</p>
          <h1>Choose your path through social media.</h1>
          <p class="lede">
            Explore posts as bubbles on a graph—prefer what you want, skip what you don’t,
            and keep discovery under your control.
          </p>
          <StoreBadges />
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="orbit">
            <span class="bubble b1"></span>
            <span class="bubble b2"></span>
            <span class="bubble b3"></span>
            <span class="bubble b4"></span>
            <span class="path"></span>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .hero {
    width: min(68rem, calc(100% - 2.5rem));
    margin: 0 auto;
    min-height: calc(100dvh - 8rem);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
    padding: 1rem 0 3rem;
  }

  .hero-copy {
    animation: rise 0.85s ease-out both;
  }

  .brand-lockup {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 7vw, 4.25rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--ink);
  }

  h1 {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 34ch;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .hero-visual {
    position: relative;
    min-height: min(52vh, 28rem);
    animation: rise 1s 0.12s ease-out both;
  }

  .orbit {
    position: absolute;
    inset: 8% 4% 12% 8%;
    border-radius: 40% 60% 55% 45% / 45% 40% 60% 55%;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--mist) 70%, white), transparent 55%),
      linear-gradient(145deg, var(--sky-mid), var(--sky-deep));
    overflow: hidden;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, white 12%, transparent);
  }

  .path {
    position: absolute;
    left: 18%;
    top: 28%;
    width: 64%;
    height: 44%;
    border: 2px dashed color-mix(in srgb, var(--mist) 55%, transparent);
    border-radius: 50% 40% 60% 45%;
    animation: path-drift 12s ease-in-out infinite alternate;
  }

  .bubble {
    position: absolute;
    border-radius: 50%;
    background: color-mix(in srgb, var(--mist) 85%, white);
    box-shadow: inset -6px -8px 16px color-mix(in srgb, var(--sky-deep) 25%, transparent);
  }

  .b1 {
    width: 5.5rem;
    height: 5.5rem;
    left: 18%;
    top: 22%;
    animation: float 5.5s ease-in-out infinite;
  }

  .b2 {
    width: 3.4rem;
    height: 3.4rem;
    left: 58%;
    top: 30%;
    background: color-mix(in srgb, var(--accent) 55%, var(--mist));
    animation: float 6.5s 0.4s ease-in-out infinite;
  }

  .b3 {
    width: 4.2rem;
    height: 4.2rem;
    left: 42%;
    top: 58%;
    animation: float 7s 0.8s ease-in-out infinite;
  }

  .b4 {
    width: 2.4rem;
    height: 2.4rem;
    left: 72%;
    top: 62%;
    background: color-mix(in srgb, var(--glow-warm) 70%, white);
    animation: float 5s 1.1s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.65rem);
    }
  }

  @keyframes path-drift {
    from {
      transform: rotate(-4deg) scale(1);
    }
    to {
      transform: rotate(5deg) scale(1.04);
    }
  }

  @media (max-width: 840px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 0.5rem;
    }

    .hero-visual {
      min-height: 16rem;
      order: -1;
    }

    .orbit {
      inset: 0;
    }
  }
</style>
